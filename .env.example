# Copy to .env (gitignored) and fill in. The backend reads it at startup.
# Gmail: use an App Password (Google account -> Security -> App passwords).
DTWIN_SMTP_HOST=smtp.gmail.com
DTWIN_SMTP_PORT=587
DTWIN_SMTP_USER=you@gmail.com
DTWIN_SMTP_PASSWORD=your-app-password
DTWIN_SMTP_FROM=you@gmail.com
# Enables the dashboard's explicit "Send for real (demo)" button. Replay never sends.
DTWIN_NOTIFY_LIVE=1
